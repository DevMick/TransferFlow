# TransferFlow Production Environment Variables
# Copy this file to .env on the VPS and update all values

# Application
NODE_ENV=production
PORT=3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://transferflow:YOUR_SECURE_PASSWORD@localhost:5432/transferflow_prod"

# Security
JWT_SECRET="GENERATE_WITH: openssl rand -base64 32"
CORS_ORIGIN="https://transfertsecur.com"

# Email (SMTP)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="support@transfertsecur.com"
SMTP_PASS="Amour##v22@"

# API Configuration
API_URL="https://transfertsecur.com/api"
WEB_URL="https://transfertsecur.com"

# Logging
LOG_LEVEL="info"

# Optional: Monitoring/Analytics
# SENTRY_DSN=""
# DATADOG_API_KEY=""
