# ---------------------------------------------------------------------------
# TransferFlow environment variables
# Copy this file to .env and fill in real values:  cp .env.example .env
# ---------------------------------------------------------------------------

# PostgreSQL 17 (matches docker-compose.yml)
DATABASE_URL="postgresql://transferflow:transferflow@localhost:5432/transferflow"

# Better-Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# API server
PORT=3000
NODE_ENV=development

# Web app (Vite) — must be prefixed with VITE_ to be exposed to the client
VITE_API_URL="http://localhost:3000"
